# GDI Notary - Variables de Entorno (copiar a .env y completar)

# API Key para autenticacion de endpoints
API_KEY=your-api-key-here

# Ambiente: test o prd
ENVIRONMENT=test

# Directorio de certificados .p12
CERTS_DIR=./certs

# TSA (Timestamp Authority) para firma PAdES
TSA_URL=http://timestamp.digicert.com

# Fallback a firma visual si no hay certificado (solo test)
FALLBACK_TO_VISUAL=true

# Gunicorn workers
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=90

# Puerto (Fly.io lo inyecta)
PORT=8001
