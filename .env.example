# =============================================================================
# GDI Backend - Variables de Entorno (copiar a .env y completar)
# =============================================================================

# --- Database (Fly.io Postgres via tunnel: flyctl proxy 5433:5432 -a <your-postgres-app>) ---
DB_HOST="localhost"
DB_PORT="5433"
DB_USER="postgres"
DB_PASSWORD="your-password"
DB_NAME="railway"

# --- App Settings ---
# SECURITY: TESTING_MODE permite bypass de Auth0 via headers X-User-ID
# - "false" (default): Requiere autenticación Auth0 real (USAR EN PRODUCCIÓN)
# - "true": Permite X-User-ID header para testing local (SOLO DESARROLLO)
# IMPORTANTE: Fly.io/producción DEBE tener TESTING_MODE=false
TESTING_MODE="false"

# --- Auth0 (autenticacion JWT) ---
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_AUDIENCE="https://your-tenant.us.auth0.com/api/v2/"
AUTH0_CLIENT_ID="your-client-id"
AUTH0_CLIENT_SECRET="your-client-secret"

# --- Cloudflare R2 (storage PDFs) ---
CF_R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
CF_R2_ACCESS_KEY_ID="your-access-key"
CF_R2_SECRET_ACCESS_KEY="your-secret-key"
CF_R2_SIGN_EXPIRATION="600"

# --- PDFComposer (genera PDFs - Fly.io) ---
PDFCOMPOSER_URL="https://<your-pdfcomposer-app>.fly.dev"
PDFCOMPOSER_API_KEY="your-api-key"

# --- Notary (firma digital PDFs - Fly.io) ---
NOTARY_URL="https://<your-notary-app>.fly.dev"
NOTARY_API_KEY="your-api-key"

# --- Email Service (Fly.io) ---
EMAIL_API_KEY="your-api-key"

# --- CORS (URL del frontend) ---
FRONTEND_URL="http://localhost:3003"

# --- Agente IA (comunicacion Backend <-> AgenteLANG) ---
AGENTE_URL="http://localhost:8004"
INTERNAL_API_KEY="your-internal-api-key"
