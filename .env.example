# =============================================================================
# GDI Backend - Variables de Entorno (copiar a .env y completar)
# =============================================================================

# --- Database (Fly.io Postgres via tunnel: flyctl proxy 5433:5432 -a <your-postgres-app>) ---
DB_HOST="localhost"
DB_PORT="5433"
DB_USER="postgres"
DB_PASSWORD="your-password"
DB_NAME="railway"

# --- App Settings ---
# GDI-249: ENVIRONMENT decide si se montan /docs, /openapi.json y /_debug/boom.
# El default del codigo es "production" (fail-closed): si no la seteas, no hay docs.
# Para desarrollo local, descomentar:
# ENVIRONMENT="development"
# SECURITY: TESTING_MODE permite bypass de Auth0 via headers X-User-ID
# - "false" (default): Requiere autenticación Auth0 real (USAR EN PRODUCCIÓN)
# - "true": Permite X-User-ID header para testing local (SOLO DESARROLLO)
# IMPORTANTE: Fly.io/producción DEBE tener TESTING_MODE=false
TESTING_MODE="false"
# SECURITY (fail-closed): en entornos sin FLY_APP_NAME dev/demo (VPS, Docker plano),
# TESTING_MODE solo se respeta si ALLOW_TESTING_MODE_LOCAL="true". Sin este opt-in,
# un TESTING_MODE=true olvidado se DESACTIVA por seguridad. Solo dev local lo setea.
ALLOW_TESTING_MODE_LOCAL="false"
# SECURITY (GDI-241): secreto compartido del modo testing. Ademas de TESTING_MODE=true,
# cada request tiene que mandar el header X-Testing-Secret con ESTE valor; si no, se lo
# trata como un request normal y va al flujo Auth0. Vacio = modo testing APAGADO,
# aunque TESTING_MODE diga true. Generar uno propio por ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ademas: TESTING_MODE=true con ENVIRONMENT=production aborta el arranque.
TESTING_SHARED_SECRET=""

# --- Auth0 (autenticacion JWT) ---
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_AUDIENCE="https://your-tenant.us.auth0.com/api/v2/"
AUTH0_CLIENT_ID="your-client-id"
AUTH0_CLIENT_SECRET="your-client-secret"

# --- Cloudflare R2 (storage PDFs) ---
CF_R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
CF_R2_ACCESS_KEY_ID="your-access-key"
CF_R2_SECRET_ACCESS_KEY="your-secret-key"
CF_R2_SIGN_EXPIRATION="600"

# --- PDFComposer (genera PDFs - Fly.io) ---
PDFCOMPOSER_URL="https://<your-pdfcomposer-app>.fly.dev"
PDFCOMPOSER_API_KEY="your-api-key"

# --- Notary (firma digital PDFs - Fly.io) ---
NOTARY_URL="https://<your-notary-app>.fly.dev"
NOTARY_API_KEY="your-api-key"

# --- Email Service (Fly.io) ---
EMAIL_SERVICE_URL="https://<your-email-service>.fly.dev"
EMAIL_API_KEY="your-api-key"

# --- CORS (URL del frontend) ---
FRONTEND_URL="http://localhost:3003"

# --- Agente IA (comunicacion Backend <-> AgenteLANG) ---
AGENTE_URL="http://localhost:8004"
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY="your-strong-random-key-here"
# Hostnames publicos que quedan restringidos a las rutas de firma (separados por
# coma). VACIO = el filtro no se aplica a ningun host.
ENLACE_HOSTS=""

# Hosts de los que PDFComposer acepta descargar imagenes sin fijar el DNS al IP
# ya resuelto. Agrega aqui SOLO dominios propios. Vacio = ninguno.
PDF_TRUSTED_HOSTS=""
PDF_TRUSTED_HOST_SUFFIXES=".r2.cloudflarestorage.com"

# Logo por defecto para caratulas y documentos cuando el municipio no configuro
# el suyo en `settings.logo_url`. Vacio = se genera sin logo.
DEFAULT_LOGO_URL=""
DEFAULT_ISOLOGO_URL=""
